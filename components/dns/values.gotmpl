---
image:
  repository: adguard/adguardhome
  tag: v0.107.55
hostNetwork: true
dnsPolicy: ClusterFirstWithHostNet  
ingress:
  main:
    enabled: true
    annotations:
      kubernetes.io/ingress.class: traefik
persistence:
  config:
    enabled: true
    type: pvc    
    accessMode: ReadWriteOnce
    mountPath: /opt/adguardhome/conf
  data:
    enabled: true
    type: pvc    
    accessMode: ReadWriteOnce
    mountPath: /opt/adguardhome/work
nodeSelector:
  kassio/dns: "true"