---
grafana:
  image:
    tag: 11.4.0
  ingress:
    enabled: true
    annotations:
      kubernetes.io/ingress.class: traefik
  nodeSelector:
    kassio/monitoring: "true"
  env:
    GF_SECURITY_ALLOW_EMBEDDING: true
kubeEtcd:
  enabled: false
prometheus:
  prometheusSpec:
    storageSpec:
      volumeClaimTemplate:
        spec:
          accessModes: ["ReadWriteOnce"]
    nodeSelector:
      kassio/monitoring: "true"
nodeSelector:
  kassio/monitoring: "true"
