---
grafana:
  image: # Prevent from warning in dashboards. Must be updated in a new installation.
    tag: 10.3.3
  ingress:
    enabled: true
    annotations:
      kubernetes.io/ingress.class: traefik
  nodeSelector:
    kassio/monitoring: "true"
  env:
    GF_SECURITY_ALLOW_EMBEDDING: true
kubeEtcd:
  enabled: false
prometheus:
  prometheusSpec:
    storageSpec:
      volumeClaimTemplate:
        spec:
          accessModes: ["ReadWriteOnce"]
    nodeSelector:
      kassio/monitoring: "true"
nodeSelector:
  kassio/monitoring: "true"
