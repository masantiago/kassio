---
image:
  repository: n8nio/n8n
  tag: 1.81.2
ingress:
  enabled: true
  className: traefik
  annotations:
    traefik.ingress.kubernetes.io/router.middlewares: kassio-remove-x-frame-options@kubernetescrd
main:
  #config:
  persistence:
    enabled: true
    type: dynamic
    accessModes:
      - ReadWriteOnce
  replicaCount: 1
  nodeSelector:
    kassio/workflow: "true"


