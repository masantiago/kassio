---
architecture: standalone
auth:
  database: kassio-db
  username: kassio
primary:
  persistence:
    enabled: true
  nodeSelector:
    kassio/db: "true"
{{- if eq .Values.components.db.platform "arm" }}
  podSecurityContext:
    enabled: false
  containerSecurityContext:
    enabled: false
image:
  repository: arm64v8/mariadb
  tag: 11.3.2
{{- else }}
image:
  repository: bitnami/mariadb
  tag: 11.3.2-debian-12-r5
{{- end -}}